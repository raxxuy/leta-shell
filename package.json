{
  "name": "leta-shell",
  "type": "module",
  "version": "0.1.28",
  "scripts": {
    "dev": "ags run . --define \"ENV='dev'\"",
    "watch": "nodemon --watch . --ext ts,tsx,json,scss --exec \"pkill gjs; sleep 0.2; bun run dev\""
  },
  "dependencies": {
    "ags": "github:Aylur/ags",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.49.0",
    "tailwind2gtk": "github:raxxuy/tailwind2gtk",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "nodemon": "^3.1.14"
  }
}
