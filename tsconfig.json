{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@/app": ["./app"],
      "@/configs/*": ["./configs/*"],
    },
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
  },
}
